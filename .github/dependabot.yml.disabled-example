# Disabled by default for portfolio stability.
# Rename this file to dependabot.yml only when you are ready to manage automated dependency PRs.
version: 2 
updates:
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "monthly"
    open-pull-requests-limit: 2
  - package-ecosystem: "npm"
    directory: "/src/frontend"
    schedule:
      interval: "monthly"
    open-pull-requests-limit: 2
  - package-ecosystem: "maven"
    directory: "/src/backend"
    schedule:
      interval: "monthly"
    open-pull-requests-limit: 2
